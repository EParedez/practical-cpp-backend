# AWS Elastic Beanstalk deployment configuration (Chapter 11).
# Deploy the C++ HTTP server on AWS with this config.

option_settings:
  aws:elasticbeanstalk:container:go:
    WSGI_PATH: /app/blog_http_server
  aws:elasticbeanstalk:application:environment:
    MONGODB_URI: mongodb://localhost:27017
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
