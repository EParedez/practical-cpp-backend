# Local-only example values. Generate unique tokens; never commit real credentials.
AUTH_REQUIRED=true
PROTECT_READ_ENDPOINTS=false
BLOG_READER_TOKEN=replace-with-at-least-32-random-characters
BLOG_WRITER_TOKEN=replace-with-at-least-32-random-characters
BLOG_ADMIN_TOKEN=replace-with-at-least-32-random-characters
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGIN=https://your-frontend.example
# TLS_CERTIFICATE_FILE=/run/secrets/tls-cert.pem
# TLS_PRIVATE_KEY_FILE=/run/secrets/tls-key.pem
